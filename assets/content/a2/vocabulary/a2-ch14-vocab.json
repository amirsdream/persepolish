  "cards": [
    { "id": "a2-ch14-w001", "polish": "życzenie", "english": "wish", "persian": "آرزو / خواسته", "pronunciation": "zhih-CHE-nyeh", "gender": "n", "partOfSpeech": "noun", "category": "emotions", "examplePolish": "Mam jedno życzenie.", "exampleEnglish": "I have one wish.", "examplePersian": "یک آرزو دارم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w001.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w002", "polish": "marzenie", "english": "dream / dream wish", "persian": "رویا / آرزوی بزرگ", "pronunciation": "ma-ZHE-nyeh", "gender": "n", "partOfSpeech": "noun", "category": "emotions", "examplePolish": "Moim marzeniem jest mieszkać w Italii.", "exampleEnglish": "My dream is to live in Italy.", "examplePersian": "رویای من زندگی در ایتالیاست.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w002.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w003", "polish": "marzyć o + locative", "english": "to dream of", "persian": "رویا داشتن از / آرزو داشتن", "pronunciation": "MA-zhich o", "gender": null, "partOfSpeech": "verb", "category": "emotions", "examplePolish": "Marzę o własnym domu.", "exampleEnglish": "I dream of my own house.", "examplePersian": "رویای خانه‌ای مخصوص خودم را دارم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w003.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w004", "polish": "pragnąć + gen / + inf", "english": "to desire / to long for", "persian": "میل داشتن / اشتیاق داشتن", "pronunciation": "PRAG-nonch", "gender": null, "partOfSpeech": "verb", "category": "emotions", "examplePolish": "Pragnę wolności.", "exampleEnglish": "I long for freedom.", "examplePersian": "مشتاق آزادی هستم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w004.mp3", "tags": ["a2-core"] },
    { "id": "a2-ch14-w005", "polish": "wolić + acc / + inf", "english": "to prefer", "persian": "ترجیح دادن", "pronunciation": "VO-lich", "gender": null, "partOfSpeech": "verb", "category": "preferences", "examplePolish": "Wolę herbatę niż kawę.", "exampleEnglish": "I prefer tea to coffee.", "examplePersian": "چای را به قهوه ترجیح می‌دهم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w005.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w006", "polish": "żałować + gen", "english": "to regret / to be sorry", "persian": "پشیمان بودن / افسوس خوردن", "pronunciation": "zha-WO-vach", "gender": null, "partOfSpeech": "verb", "category": "emotions", "examplePolish": "Żałuję, że nie przyszedłem.", "exampleEnglish": "I regret not coming.", "examplePersian": "از اینکه نیامدم پشیمانم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w006.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w007", "polish": "szkoda, że", "english": "it's a pity that / what a shame", "persian": "حیف که / چه حیف", "pronunciation": "SHKO-da zheh", "gender": null, "partOfSpeech": "phrase", "category": "emotions", "examplePolish": "Szkoda, że nie możesz przyjść.", "exampleEnglish": "It's a pity you can't come.", "examplePersian": "حیف که نمی‌توانی بیایی.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w007.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w008", "polish": "niestety", "english": "unfortunately", "persian": "متأسفانه", "pronunciation": "nyes-TE-tih", "gender": null, "partOfSpeech": "adverb", "category": "emotions", "examplePolish": "Niestety nie mogę przyjść.", "exampleEnglish": "Unfortunately I can't come.", "examplePersian": "متأسفانه نمی‌توانم بیایم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w008.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w009", "polish": "na szczęście", "english": "fortunately / luckily", "persian": "خوشبختانه / خوشبختی", "pronunciation": "na SHCHEN-shchyeh", "gender": null, "partOfSpeech": "phrase", "category": "emotions", "examplePolish": "Na szczęście zdążyłem.", "exampleEnglish": "Fortunately I made it in time.", "examplePersian": "خوشبختانه به موقع رسیدم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w009.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w010", "polish": "gdyby", "english": "if (hypothetical)", "persian": "اگر (فرضی)", "pronunciation": "GDIH-bih", "gender": null, "partOfSpeech": "conjunction", "category": "grammar-function", "examplePolish": "Gdybym miała pieniądze, pojechałabym w podróż.", "exampleEnglish": "If I had money, I would go on a trip.", "examplePersian": "اگر پول داشتم، به سفر می‌رفتم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w010.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w011", "polish": "na twoim miejscu", "english": "if I were you / in your place", "persian": "جای تو بودم / اگر جای تو بودم", "pronunciation": "na TVOH-eem MYES-tsoo", "gender": null, "partOfSpeech": "phrase", "category": "conditionals", "examplePolish": "Na twoim miejscu zadzwoniłbym do niej.", "exampleEnglish": "If I were you, I'd call her.", "examplePersian": "جای تو بودم بهش زنگ می‌زدم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w011.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w012", "polish": "szczęście", "english": "happiness / luck", "persian": "خوشبختی / شانس", "pronunciation": "SHCHEN-shchyeh", "gender": "n", "partOfSpeech": "noun", "category": "emotions", "examplePolish": "Życzę ci dużo szczęścia.", "exampleEnglish": "I wish you a lot of happiness.", "examplePersian": "برایت آرزوی خوشبختی فراوان دارم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w012.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w013", "polish": "smutny / smutna", "english": "sad", "persian": "غمگین / ناراحت", "pronunciation": "SMOOT-nih / SMOOT-na", "gender": "m/f", "partOfSpeech": "adjective", "category": "emotions", "examplePolish": "Jestem smutny, bo nie zdałem egzaminu.", "exampleEnglish": "I'm sad because I didn't pass the exam.", "examplePersian": "غمگینم چون در امتحان قبول نشدم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w013.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w014", "polish": "szczęśliwy / szczęśliwa", "english": "happy", "persian": "خوشحال / خوشبخت", "pronunciation": "shchen-SHLEE-vih / shchen-SHLEE-va", "gender": "m/f", "partOfSpeech": "adjective", "category": "emotions", "examplePolish": "Byłabym szczęśliwa, gdybyś tu był.", "exampleEnglish": "I would be happy if you were here.", "examplePersian": "خوشحال می‌شدم اگر اینجا بودی.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w014.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w015", "polish": "woleć niż", "english": "to prefer ... rather than / to", "persian": "ترجیح دادن بر", "pronunciation": "VO-lich nyazh", "gender": null, "partOfSpeech": "phrase", "category": "preferences", "examplePolish": "Wolę góry niż morze.", "exampleEnglish": "I prefer mountains to the sea.", "examplePersian": "کوه را به دریا ترجیح می‌دهم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w015.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w016", "polish": "powodzenie", "english": "good luck / success", "persian": "موفق باشی / موفقیت", "pronunciation": "po-vo-DZE-nyeh", "gender": "n", "partOfSpeech": "noun", "category": "social", "examplePolish": "Powodzenia na egzaminie!", "exampleEnglish": "Good luck on the exam!", "examplePersian": "در امتحان موفق باشی!", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w016.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w017", "polish": "narzekać na + acc", "english": "to complain about", "persian": "شکایت کردن از / غر زدن", "pronunciation": "na-ZHE-kach na", "gender": null, "partOfSpeech": "verb", "category": "emotions", "examplePolish": "Nie narzekaj na pogodę.", "exampleEnglish": "Don't complain about the weather.", "examplePersian": "از هوا شکایت نکن.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w017.mp3", "tags": ["a2-core"] },
    { "id": "a2-ch14-w018", "polish": "cieszyć się z + gen", "english": "to be pleased/happy about", "persian": "خوشحال شدن از / خوشحال بودن از", "pronunciation": "CHE-shich shyeh z", "gender": null, "partOfSpeech": "verb", "category": "emotions", "examplePolish": "Cieszę się z twojego sukcesu.", "exampleEnglish": "I'm happy about your success.", "examplePersian": "از موفقیتت خوشحالم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w018.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w019", "polish": "bać się + gen", "english": "to be afraid of", "persian": "ترسیدن از", "pronunciation": "BACH shyeh", "gender": null, "partOfSpeech": "verb", "category": "emotions", "examplePolish": "Bałabym się tak zrobić.", "exampleEnglish": "I would be afraid to do that.", "examplePersian": "از انجام آن می‌ترسیدم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w019.mp3", "tags": ["high-frequency", "a2-core"] },
    { "id": "a2-ch14-w020", "polish": "ideał / idealny", "english": "ideal / perfect", "persian": "ایده‌آل / کامل", "pronunciation": "i-DE-aw / i-de-AL-nih", "gender": "m/adj", "partOfSpeech": "noun/adjective", "category": "abstract", "examplePolish": "To byłoby idealne.", "exampleEnglish": "That would be ideal.", "examplePersian": "آن ایده‌آل می‌بود.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w020.mp3", "tags": ["a2-core"] },
    { "id": "a2-ch14-w021", "polish": "wymarzyć sobie", "english": "to dream up / wish for", "persian": "آرزو کردن / رویا دیدن", "pronunciation": "vi-MA-zhich SO-bye", "gender": null, "partOfSpeech": "verb", "category": "emotions", "examplePolish": "Wymarzyłam sobie wakacje na Majorce.", "exampleEnglish": "I dreamed of a holiday in Majorca.", "examplePersian": "آرزوی تعطیلات در ماژورکا را داشتم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w021.mp3", "tags": ["a2-core"] },
    { "id": "a2-ch14-w022", "polish": "spełniać / spełnić marzenie", "english": "to fulfil a dream", "persian": "رویا را به واقعیت تبدیل کردن", "pronunciation": "spew-NYACH / SPEW-nyich ma-ZHE-nyeh", "gender": null, "partOfSpeech": "phrase", "category": "emotions", "examplePolish": "W końcu spełniłem swoje marzenie.", "exampleEnglish": "I finally fulfilled my dream.", "examplePersian": "بالاخره رویایم را به واقعیت تبدیل کردم.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w022.mp3", "tags": ["a2-core"] },
    { "id": "a2-ch14-w023", "polish": "w innym wypadku", "english": "otherwise / in another case", "persian": "وگرنه / در غیر این صورت", "pronunciation": "v IN-nim VIH-pad-koo", "gender": null, "partOfSpeech": "phrase", "category": "conditionals", "examplePolish": "Zrób to teraz, w innym wypadku będzie za późno.", "exampleEnglish": "Do it now, otherwise it'll be too late.", "examplePersian": "الان انجامش بده، وگرنه دیر می‌شود.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w023.mp3", "tags": ["a2-core"] },
    { "id": "a2-ch14-w024", "polish": "powinien / powinna", "english": "should / ought to (m/f)", "persian": "باید / لازم است (م / م)", "pronunciation": "po-VEE-nyen / po-VEE-na", "gender": "m/f", "partOfSpeech": "modal", "category": "grammar-function", "examplePolish": "Powinieneś iść do lekarza.", "exampleEnglish": "You should go to the doctor.", "examplePersian": "باید پیش دکتر بروی.", "audioAsset": "assets/audio/a2/ch14/a2-ch14-w024.mp3", "tags": ["high-frequency", "a2-core"] },
