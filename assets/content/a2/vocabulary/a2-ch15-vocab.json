    { "id": "a2-ch15-w006", "polish": "złość", "english": "anger", "persian": "خشم / عصبانیت", "pronunciation": "ZWOSHCH", "gender": "f", "partOfSpeech": "noun", "category": "emotions", "examplePolish": "Czuję złość, kiedy kłamiecie.", "exampleEnglish": "I feel angry when you lie.", "examplePersian": "وقتی دروغ می‌گویید خشم می‌کنم.", "audioAsset": "assets/audio/a2/ch15/a2-ch15-w006.mp3", "tags": ["a2-core"] },
