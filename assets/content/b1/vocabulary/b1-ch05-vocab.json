    { "id": "b1-ch05-w009", "polish": "niż", "english": "than (in comparisons)", "persian": "از / تا (در مقایسه‌ها)", "pronunciation": "nyish", "gender": null, "partOfSpeech": "conjunction", "category": "comparison", "examplePolish": "Wolałbym kawę niż herbatę.", "exampleEnglish": "I'd prefer coffee rather than tea.", "examplePersian": "قهوه را به چای ترجیح می‌دادم.", "audioAsset": "assets/audio/b1/ch05/vocab/b1-ch05-w009.mp3", "tags": ["comparison", "conditional"] },
