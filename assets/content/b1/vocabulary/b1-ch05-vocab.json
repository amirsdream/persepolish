    { "id": "b1-ch05-w005", "polish": "mógłby Pan / mogłaby Pani", "english": "could you (formal m/f)", "persian": "آیا می‌توانستید (رسمی مذکر/مؤنث)", "pronunciation": "MOOGW-by pan / mo-GWAH-by PA-nyee", "gender": "m/f", "partOfSpeech": "phrase", "category": "conditional-formal", "examplePolish": "Czy mógłby Pan powtórzyć?", "exampleEnglish": "Could you repeat that?", "examplePersian": "ممکن است تکرار بفرمایید؟", "audioAsset": "assets/audio/b1/ch05/vocab/b1-ch05-w005.mp3", "tags": ["conditional", "formal", "polite", "pan-pani"] },
    { "id": "b1-ch05-w006", "polish": "na twoim miejscu", "english": "if I were you", "persian": "اگر جای تو بودم", "pronunciation": "na TVOim MYEYS-tsu", "gender": null, "partOfSpeech": "phrase", "category": "conditional", "examplePolish": "Na twoim miejscu poszedłbym do lekarza.", "exampleEnglish": "If I were you, I'd go to the doctor.", "examplePersian": "اگر جای تو بودم به دکتر می‌رفتم.", "audioAsset": "assets/audio/b1/ch05/vocab/b1-ch05-w006.mp3", "tags": ["conditional", "phrase", "hypothetical"] },
    { "id": "b1-ch05-w007", "polish": "gdybym tylko", "english": "if only I", "persian": "کاش / ای‌کاش", "pronunciation": "GDY-bym TYL-ko", "gender": null, "partOfSpeech": "phrase", "category": "conditional", "examplePolish": "Gdybym tylko mógł, pojechałbym do Japonii.", "exampleEnglish": "If only I could, I would go to Japan.", "examplePersian": "کاش می‌توانستم به ژاپن می‌رفتم.", "audioAsset": "assets/audio/b1/ch05/vocab/b1-ch05-w007.mp3", "tags": ["conditional", "wish"] },
