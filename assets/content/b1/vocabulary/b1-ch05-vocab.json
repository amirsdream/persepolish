    { "id": "b1-ch05-w002", "polish": "chciałbym / chciałabym", "english": "I would like (m/f)", "persian": "دوست داشتم / می‌خواستم (مذکر/مؤنث)", "pronunciation": "hchaw-BYM / hcha-WAH-bym", "gender": "m/f", "partOfSpeech": "verb-conditional", "category": "conditional", "examplePolish": "Chciałbym zamówić kawę.", "exampleEnglish": "I would like to order a coffee.", "examplePersian": "دوست داشتم یک قهوه سفارش دهم.", "audioAsset": "assets/audio/b1/ch05/vocab/b1-ch05-w002.mp3", "tags": ["conditional", "polite", "key"] },
    { "id": "b1-ch05-w003", "polish": "wolałbym / wolałabym", "english": "I would prefer / I'd rather (m/f)", "persian": "ترجیح می‌دادم (مذکر/مؤنث)", "pronunciation": "vo-WAW-bym / vo-WAH-wah-bym", "gender": "m/f", "partOfSpeech": "verb-conditional", "category": "conditional", "examplePolish": "Wolałabym zostać w domu.", "exampleEnglish": "I'd rather stay home.", "examplePersian": "ترجیح می‌دادم در خانه بمانم.", "audioAsset": "assets/audio/b1/ch05/vocab/b1-ch05-w003.mp3", "tags": ["conditional", "preference"] },
